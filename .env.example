# Copy this file to .env and fill in only the credentials you actually need.

# OpenAI-compatible providers
OPENAI_API_KEY=

# Optional bearer token for remote / cloud Ollama endpoints
OLLAMA_API_KEY=
# Alternative name accepted by the model factory:
OLLAMA_CLOUD_API_KEY=

# LangSmith / LangChain tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=virage-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
