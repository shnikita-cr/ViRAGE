@startuml
skinparam shadowing false
skinparam monochrome true
skinparam roundcorner 12
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 17
skinparam ArrowFontSize 13
skinparam ArrowThickness 2
skinparam linetype ortho
skinparam dpi 600

skinparam activity {
  BorderColor black
  BackgroundColor white
}

skinparam diamond {
  BorderColor black
  BackgroundColor white
}

<style>
activityDiagram {
  activity {
    HorizontalAlignment center
  }

  diamond {
    HorizontalAlignment center
  }
}
</style>

start

:Получить запрос и входные данные;

if () then (Получена таблица)
  :Загрузить таблицу;
else (Получены изображения)
  :Сформировать таблицу
численных характеристик;
endif

:Составить план анализа;

repeat
  :Выбрать аналитическую подзадачу;
  :Сгенерировать спецификацию\nи провести валидацию;
  :Сохранить спецификацию,
изображение диаграммы и вывод;
repeat while () is (Остались подзадачи\n из плана) not (Все подзаачи\nвыполнены)


:Сохранить артефакты выполнения;
:Вернуть диаграммы и выводы
пользователю;

stop
@enduml
