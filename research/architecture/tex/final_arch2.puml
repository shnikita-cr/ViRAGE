@startuml
title Шаги работы ViRAGE
skinparam shadowing false
skinparam monochrome true
skinparam roundcorner 12
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 17
skinparam ArrowFontSize 13
skinparam ArrowThickness 2
skinparam linetype ortho
skinparam dpi 600'

skinparam activity {
  BorderColor black
  BackgroundColor white
}

skinparam diamond {
  BorderColor black
  BackgroundColor white
}

start

:Получить запрос и входные данные;

if () then (Тип входа таблица)
  :Загрузить таблицу;
else (Тип входа изображения)
  :Рассчитать метрики;
  :Сформировать таблицу метрик;
endif

:Построить профиль данных;
:Найти знания в VisRAG для планирования;
:Составить план анализа;

repeat
  :Выбрать аналитическую задачу;
  :Найти правила визуализации в VisRAG;
  :Сгенерировать Vega-Lite спецификацию;
  :Проверить спецификацию;
  :Построить PNG-график;
  :VLM оценка;

  if () then (График принят)
    :Сохранить график,\nспецификацию и вывод;
  else (График не принят)
    :Передать замечания\nв повторную генерацию;
  endif

repeat while () is (Остались другие задачи из плана)

:Сохранить артефакты запуска;
:Вернуть графики и выводы пользователю;

stop
@enduml