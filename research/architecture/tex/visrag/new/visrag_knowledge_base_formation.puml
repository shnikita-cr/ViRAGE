skinparam ActivityBarColor black
<style>
activityDiagram {
  activity {
    HorizontalAlignment center
  }
  diamond {
    HorizontalAlignment center
  }
}
</style>

start

:Получить источники знаний
о визуализации, анализе данных
и предметной области;

:Извлечь правила,
ограничения и рекомендации;

:Нормализовать записи
по единой структуре;

:Классифицировать записи
по назначению и источнику;

fork
  :Вычислить векторные представления
  nomic-embed-text, n = 768;
  :Сохранить документы,
метаданные и векторные представления
в Chroma;
fork again
  :Токенизировать тексты и метаданные;
  :Подготовить лексический индекс
для поиска BM25;
end fork
stop
@enduml
