@startuml
skinparam shadowing false
skinparam monochrome true
skinparam roundcorner 12
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 17
skinparam ArrowFontSize 13
skinparam ArrowThickness 2
skinparam linetype ortho
skinparam dpi 600

skinparam activity {
BorderColor black
BackgroundColor white
}

<style>
activityDiagram {
activity {
HorizontalAlignment center
}

diamond {
HorizontalAlignment center
}
}
</style>

skinparam diamond {
BorderColor black
BackgroundColor white
}

start

repeat

repeat
:Генерация\nVega-Lite спецификации;
:Проверка\nспецификации;

if ( ) then (спецификация\nвалидна)

:Рендер диаграммы\nи получение графа сцены;
:Проверка построения\nи непустоты;

if ( ) then (диаграмма построена\nи не пуста)

:Техническая проверка\nпройдена;

else (диаграмма не построена\nили пуста)

if ( ) then (лимит технических\nповторов исчерпан)
:Техническая ошибка\n построения;
stop
else (лимит технических\nповторов не исчерпан)
: Технический повтор:\nисправить спецификацию;
endif

endif

else (спецификация\nневалидна)

if ( ) then (лимит технических\nповторов исчерпан)
: Ошибка\nгенерации;
stop
else (лимит технических\nповторов не исчерпан)
:Технический повтор:\nисправить спецификацию;
endif

endif

repeat while ( ) is (нужен технический\nповтор) not (техническая проверка\nпройдена)

:VLM оценка:\nсоответствие диаграммы запросу и корректности;

if ( ) then (диаграмма отвечает\nзапросу и корректна)

:Принять текущий\n вариант;

else (диаграмма не отвечает\nзапросу или не корректна)

if ( ) then (лимит семантических\nповторов исчерпан)
:Выбрать лучший\nполученный вариант;
else (лимит семантических\nповторов не исчерпан)
:Семантический повтор:\nучесть замечания VLM;
endif

endif

repeat while ( ) is (нужен семантический\nповтор) not (вариант выбран)

:Итоговый\nVLM-анализ;

stop

@enduml