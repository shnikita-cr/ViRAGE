@startuml
title Архитектура подсистемы VisRAG

left to right direction

skinparam shadowing false
skinparam monochrome true
skinparam roundcorner 12
skinparam defaultFontSize 18
skinparam ArrowThickness 2
skinparam nodesep 45
skinparam ranksep 60
skinparam linetype ortho
skinparam dpi 600

skinparam rectangle {
  BorderColor black
  BackgroundColor white
}

rectangle "Источники знаний\nо визуализации" as Sources
rectangle "Извлечение и\nнормализация правил" as Normalize
rectangle "Фрагменты корпуса\nrecommendation chunks" as Chunks
rectangle "Построение\nэмбеддингов" as Embeddings
database "Векторное\nхранилище" as VectorStore

rectangle "Аналитическая\nзадача" as Task
rectangle "Профиль\nданных" as Profile
rectangle "Поисковый\nзапрос" as SearchQuery
rectangle "Поиск близких\nфрагментов" as Retrieval
rectangle "Ранжирование\nи отбор правил" as Ranking
rectangle "Рекомендации\nдля визуализации" as Guidance
rectangle "Генератор\nVega-Lite" as SpecGenerator

Sources --> Normalize
Normalize --> Chunks
Chunks --> Embeddings
Embeddings --> VectorStore

Task --> SearchQuery
Profile --> SearchQuery
SearchQuery --> Retrieval
VectorStore --> Retrieval
Retrieval --> Ranking
Ranking --> Guidance
Guidance --> SpecGenerator

@enduml