@startuml
title Планирование аналитических подзадач в ViRAGE

skinparam shadowing false
skinparam monochrome true
skinparam roundcorner 12
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 18
skinparam ArrowFontSize 16
skinparam ArrowThickness 2
skinparam linetype ortho
skinparam dpi 600

skinparam activity {
  BorderColor black
  BackgroundColor white
}

start

:Получить пользовательский запрос\nи таблицу данных;
:Построить профиль данных;
:Определить доступные поля,\nтипы данных и ограничения таблицы;
:Выделить аналитическое намерение\nпользователя;

if (Запрос содержит несколько\nаналитических целей?) then (да)
  :Разделить запрос\nна аналитические подзадачи;
else (нет)
  :Создать одну аналитическую\nподзадачу;
endif

:Ограничить число подзадач\nдо установленного предела;
:Назначить каждой подзадаче\nцель анализа;
:Выбрать поля таблицы,\nнеобходимые для каждой подзадачи;
:Определить предпочтительный\nтип визуализации;
:Получить рекомендации VisRAG\nдля каждой подзадачи;
:Сформировать план выполнения;

repeat
  :Выполнить очередную\nаналитическую подзадачу;
  :Сохранить спецификацию,\nграфик и текстовый анализ;
repeat while (Остались невыполненные\nподзадачи?) is (да) not (нет)

:Агрегировать результаты\nв единый ответ;
:Сформировать итоговый вывод\nдля пользователя;

stop

@enduml