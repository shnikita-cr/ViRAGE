{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virage.local/schemas/visrag_corpus_record.schema.json",
  "title": "ViRAGE VisRAG Corpus Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "source",
    "corpus_type",
    "instruction"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "corpus_type": {
      "type": "string",
      "enum": [
        "example",
        "rule",
        "dataset_profile",
        "success_case",
        "failure_case",
        "utterance",
        "ambiguity_case",
        "design_constraint"
      ]
    },
    "quality_tier": {"type": "string"},
    "source_weight": {"type": "number", "minimum": 0.0},
    "language": {"type": "string"},
    "domain": {"type": "string"},
    "instruction": {"type": "string", "minLength": 1},
    "query_variants": {"type": "array", "items": {"type": "string"}},
    "mark_type": {
      "type": "string",
      "enum": [
        "",
        "area",
        "bar",
        "circle",
        "line",
        "point",
        "rect",
        "rule",
        "square",
        "text",
        "tick",
        "geoshape",
        "boxplot",
        "errorbar",
        "errorband"
      ]
    },
    "chart_type": {"type": "string"},
    "chart_pattern": {"type": "string"},
    "task_type": {"type": "string"},
    "field_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["quantitative", "temporal", "ordinal", "nominal", "geojson", "boolean", "unknown"]
      }
    },
    "required_channels": {"type": "array", "items": {"type": "string"}},
    "optional_channels": {"type": "array", "items": {"type": "string"}},
    "transforms": {"type": "array", "items": {"type": "string"}},
    "transform_types": {"type": "array", "items": {"type": "string"}},
    "data_constraints": {"type": "array", "items": {"type": "string"}},
    "negative_conditions": {"type": "array", "items": {"type": "string"}},
    "spec_template": {"type": ["object", "null"]},
    "validation": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
